# pi runtime data (live session history for /resume, /continue)
sessions/

# credentials & generated caches — never commit
auth.json
models-store.json

# local-only binaries (rg/fd live only here on this machine)
bin/

# pi npm package installs (reproducible via `pi install npm:...`)
npm/

# pi UI/runtime state — machine-local, changes on every session
settings.json
trust.json
notify-done.log

# extension configs — personal tuning, may hold secrets; defaults live in code
config.json
devcontainer-bash.json
**/searxng-config/settings.yml

# local-only dependency links
**/node_modules/
