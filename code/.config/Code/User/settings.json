{
    "security.workspace.trust.untrustedFiles": "open",
    // "terminal.integrated.fontFamily": "'Cascadia Mono', monospace",
    "files.autoSave": "afterDelay",
    "git.autofetch": "all",
    "git.enableSmartCommit": true,
    "workbench.editorAssociations": {
        "*.ipynb": "jupyter-notebook",
        "*.bag": "default",
        "*.shp": "default"
    },
    "files.watcherExclude": {
        ".catkin_tools": true,
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.vscode/**": true,
        "build/": true,
        "install/": true,
        "log/": true
    },
    "files.exclude": {
        "": true,
        "**/__pycache__/": true,
        "**/.DS_Store": false,
        "**/.git": false,
        "**/.git/*": true,
        "**/.hg": false,
        "**/.svn": false,
        "**/Thumbs.db": false,
        "build/*": true,
        "install/*": true,
        "log/*": true
    },
    "window.restoreFullscreen": true,
    "git.postCommitCommand": "push",
    "git.confirmSync": false,
    "editor.suggestSelection": "first",
    "files.trimFinalNewlines": true,
    "workbench.list.smoothScrolling": true,
    "editor.guides.bracketPairs": true,
    "cmake.configureOnOpen": true,
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": true
    },
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "files.trimTrailingWhitespace": true,
    "editor.inlineSuggest.enabled": true,
    "github.copilot.enable": {
        "*": true,
        "plaintext": true,
        "markdown": true,
        "scminput": false,
        "yaml": true
    },
    "editor.unicodeHighlight.invisibleCharacters": false,
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "[dockerfile]": {
        "editor.defaultFormatter": "ms-azuretools.vscode-docker"
    },
    "symlink-follow.autoFollow": true,
    "git.pruneOnFetch": true,
    "git.autoStash": true,
    "git.closeDiffOnOperation": true,
    "git.inputValidationSubjectLength": null,
    "git.terminalGitEditor": true,
    "scm.showActionButton": false,
    "git.allowNoVerifyCommit": true,
    "git.confirmNoVerifyCommit": false,
    "terminal.integrated.persistentSessionReviveProcess": "never",
    "jsonServer.exampleConfiguration": "Iñigo",
    "files.associations": {
        "CMake*.txt": "cmake",
        ".rosinstall": "yaml",
        "*.cpp.autogen": "cpp",
        "*.mlx": "xml",
        "*.cpp.in": "cpp"
    },
    "[markdown]": {
        "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
        "diffEditor.ignoreTrimWhitespace": true
    },
    "editor.fontLigatures": true,
    "git.mergeEditor": true,
    "editor.cursorSurroundingLines": 5,
    "[python]": {
        "editor.formatOnType": true,
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        }
    },
    "git.useCommitInputAsStashMessage": true,
    "editor.renderWhitespace": "none",
    "workbench.editor.preferHistoryBasedLanguageDetection": true,
    "autopep8.args": [
        "--max-line-length",
        "120",
        "--experimental",
        "-aa"
    ],
    "python.formatting.autopep8Args": [
        "--max-line-length",
        "120",
        "--experimental",
        "-aa"
    ],
    "flake8.args": [
        "--max-line-length=120",
        "--disable=D107"
    ],
    "markdownlint.config": {
        "MD013": false,
        "MD014": false,
        "MD024": false
    },
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit",
        "source.organizeImports": "explicit"
    },
    "editor.wordWrap": "on",
    "files.simpleDialog.enable": true,
    "workbench.tree.renderIndentGuides": "always",
    "python.analysis.inlayHints.functionReturnTypes": true,
    "python.analysis.inlayHints.pytestParameters": true,
    "explorer.excludeGitIgnore": false,
    "editor.inlineSuggest.showToolbar": "always",
    "python.envFile": "${workspaceFolder}/.env",
    "python.autoComplete.extraPaths": [
        "/opt/ros/jazzy/lib/python3.12/site-packages",
    ],
    "python.analysis.extraPaths": [
        "/opt/ros/jazzy/lib/python3.12/site-packages",
    ],
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "explorer.confirmDragAndDrop": false,
    "remote.autoForwardPortsSource": "hybrid",
    "remote.autoForwardPorts": false,
    "remote.forwardOnOpen": false,
    "remote.restoreForwardedPorts": false,
    "dev.containers.forwardWSLServices": false,
    "dev.containers.mountWaylandSocket": false,
    "terminal.integrated.commandsToSkipShell": [
        "-workbench.action.showCommands"
    ],
    "cmake.pinnedCommands": [
        "workbench.action.tasks.configureTaskRunner",
        "workbench.action.tasks.runTask"
    ],
    "cmake.showConfigureWithDebuggerNotification": false,
    "terminal.integrated.enableImages": true,
    "python.terminal.shellIntegration.enabled": true,
    "diffEditor.ignoreTrimWhitespace": false,
    "C_Cpp.workspaceParsingPriority": "low",
    "chat.editing.confirmEditRequestRemoval": false,
    "git.replaceTagsWhenPull": true,
    "[csv]": {
        "editor.inlayHints.maximumLength": 0
    },
    "[tsv]": {
        "editor.inlayHints.maximumLength": 0
    },
    "cmake.enableAutomaticKitScan": false,
    "terminal.integrated.initialHint": false,
    "editor.minimap.enabled": false,
    "scm.repositories.visible": 0,
    "git.repositoryScanMaxDepth": 3,
    "explorer.confirmPasteNative": false,
    "explorer.confirmDelete": false,
    "remote.defaultExtensionsIfInstalledLocally": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "GitHub.vscode-pull-request-github",
        "ms-python.python",
        "ms-vscode.cpptools",
        "charliermarsh.ruff",
        "DavidAnson.vscode-markdownlint"
    ],
    "workbench.activityBar.location": "top",
    "C_Cpp.intelliSenseEngine": "disabled",
    "ruff.lineLength": 120,
    "ruff.configuration": {
        "lint": {
            "select": [
                "E",
                "W",
                "F",
                "I",
                "A",
                "ERA",
                "RET",
                "PLR"
            ],
            "pylint": {
                "max-statements": 100
            },
            "isort": {
                "combine-as-imports": true,
                "split-on-trailing-comma": false
            }
        }
    },
    "git.openRepositoryInParentFolders": "never",
    "git.autofetchPeriod": 300,
    "clangd.path": "~/.config/Code/User/globalStorage/llvm-vs-code-extensions.vscode-clangd/install/22.1.0/clangd_22.1.0/bin/clangd",
    "ROS2.autoShowOutputChannel": false,
    "workbench.startupEditor": "none",
    "git.fetchOnPull": true,
    "continue.enableTabAutocomplete": false,
    "github.copilot.nextEditSuggestions.enabled": true,
    "scm.defaultViewMode": "tree",
    "scm.alwaysShowRepositories": true,
    "terminal.explorerKind": "both",
    "problems.decorations.enabled": false,
    "editor.fontFamily": "JetBrainsMono Nerd Font Mono",
    "terminal.integrated.fontLigatures.enabled": true,
    "workbench.colorTheme": "Gruvbox Dark Medium",
}