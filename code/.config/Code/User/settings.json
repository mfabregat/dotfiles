{
    "security.workspace.trust.untrustedFiles": "open",
    // "terminal.integrated.fontFamily": "'Cascadia Mono', monospace",
    "files.autoSave": "afterDelay",
    "git.autofetch": "all",
    "containers.containerClient": "com.microsoft.visualstudio.containers.docker",
    "containers.orchestratorClient": "com.microsoft.visualstudio.orchestrators.dockercompose",
    "git.enableSmartCommit": true,
    "docker.containers.groupBy": "Compose Project Name",
    "workbench.editorAssociations": {
        "*.ipynb": "jupyter-notebook",
        "*.bag": "default",
        "*.shp": "default"
    },
    "material-icon-theme.files.associations": {
        "**.rosinstall": "git",
        "**.repos": "git",
        ".cmake-format": "cmake"
    },
    "jupyter.widgetScriptSources": [
        "jsdelivr.com",
        "unpkg.com"
    ],
    "material-icon-theme.folders.associations": {
        // "cmake": "cmake"
    },
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        ".catkin_tools": true,
        // "**/node_modules/*/**": true,
        // "**/.hg/store/**": true,
        // "**/.adobe/**": true,
        // "**/.ansible/**": true,
        // "**/.cache/**": true,
        // "**/.config/**": true,
        // "**/.docker/**": true,
        // "**/.firefox/**": true,
        // "**/.gnupg/**": true,
        // "**/.hplip/**": true,
        // "**/.local/**": true,
        // "**/.mozilla/**": true,
        // "**/.nv/**": true,
        // // "**/.oh-my-zsh/**": true,
        // "**/.pki/**": true,
        // "**/.ros/**": true,
        // "**/.vagrant.d/**": true,
        // "**/.venv/bin/**": true,
        // "**/.venv/include/**": true,
        // "**/.venv/lib/**": true,
        // "**/.venv/lib64/**": true,
        // "**/.venv/share/**": true,
        "**/.vscode/**": true,
        // "**/.Xauthority/**": true
    },
    "files.exclude": {
        "**/.DS_Store": false,
        "**/.git": false,
        "**/.hg": false,
        "**/.svn": false,
        "**/*.pyc": true,
        "**/Thumbs.db": false
    },
    "docker.containers.label": "ContainerName",
    "docker.containers.description": [
        "ImageId",
        "Status"
    ],
    "git-graph.maxDepthOfRepoSearch": 2,
    "git-graph.repository.commits.fetchAvatars": true,
    "window.restoreFullscreen": true,
    "pyqt-integration.qtdesigner.path": "/usr/lib/qt5/bin/designer",
    "git.postCommitCommand": "push",
    "git.confirmSync": false,
    "editor.suggestSelection": "first",
    "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
    "files.trimFinalNewlines": true,
    "workbench.list.smoothScrolling": true,
    "editor.guides.bracketPairs": true,
    "cmake.configureOnOpen": true,
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "files.trimTrailingWhitespace": true,
    "editor.inlineSuggest.enabled": true,
    "github.copilot.enable": {
        "*": true,
        "yaml": true,
        "plaintext": true,
        "markdown": true
    },
    "editor.unicodeHighlight.invisibleCharacters": false,
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "[dockerfile]": {
        "editor.defaultFormatter": "ms-azuretools.vscode-docker"
    },
    "copyrightInserter.holder": "TECNALIA",
    "symlink-follow.autoFollow": true,
    "git.pruneOnFetch": true,
    "git.autoStash": true,
    "git.closeDiffOnOperation": true,
    "git.inputValidationSubjectLength": null,
    "git.terminalGitEditor": true,
    "terminal.integrated.defaultProfile.linux": "zsh",
    "scm.showActionButton": false,
    "git.allowNoVerifyCommit": true,
    "git.confirmNoVerifyCommit": false,
    "terminal.integrated.persistentSessionReviveProcess": "never",
    "jsonServer.exampleConfiguration": "Iñigo",
    "files.associations": {
        "CMake*.txt": "cmake",
        ".rosinstall": "yaml",
        "*.cpp.autogen": "cpp",
        "*.mlx": "xml",
        "*.cpp.in": "cpp"
    },
    "[markdown]": {
        "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
        "diffEditor.ignoreTrimWhitespace": true
    },
    "formatFiles.excludedFolders": [
        "node_modules",
        ".vscode",
        ".git",
        "dist",
        ".chrome",
        "**/.git"
    ],
    "formatFiles.excludePattern": "**/.git/**",
    "editor.fontLigatures": true,
    "customizeUI.font.monospace": "'Cascadia Mono'",
    "customizeUI.font.regular": "'Cascadia Code'",
    "customizeUI.titleBar": "inline",
    "material-icon-theme.folders.theme": "specific",
    "material-icon-theme.folders.color": "#90a4ae",
    "material-icon-theme.opacity": 1,
    "material-icon-theme.saturation": 1,
    "material-icon-theme.activeIconPack": "angular",
    "material-icon-theme.hidesExplorerArrows": false,
    "git.mergeEditor": true,
    "haskell.manageHLS": "GHCup",
    "xml.format.maxLineWidth": 0,
    "editor.cursorSurroundingLines": 5,
    "[python]": {
        "editor.formatOnType": true,
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        }
    },
    "git.useCommitInputAsStashMessage": true,
    "gitblame.commitUrl": "${tool.protocol}//${gitorigin.hostname}${gitorigin.port}${gitorigin.path}/blob/${hash}/${file.path}/#L${file.line}",
    "3dviewer.boundingBox": true,
    "3dviewer.limitFps": 30,
    "3dviewer.hotReload": false,
    "3dpreview.showMesh": false,
    "editor.renderWhitespace": "none",
    "workbench.editor.preferHistoryBasedLanguageDetection": true,
    "[latex]": {
        "editor.defaultFormatter": "James-Yu.latex-workshop"
    },
    "autopep8.args": [
        "--max-line-length",
        "120",
        "--experimental",
        "-aa"
    ],
    "python.formatting.autopep8Args": [
        "--max-line-length",
        "120",
        "--experimental",
        "-aa"
    ],
    "markdownlint.config": {
        "MD013": false,
        "MD014": false,
        "MD024": false
    },
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit",
        "source.organizeImports": "explicit"
    },
    "markdown-preview-github-styles.darkTheme": "dark_dimmed",
    "latex-workshop.latex.autoBuild.interval": 10000,
    "latex-workshop.latex.autoBuild.run": "never",
    "python.formatting.provider": "none",
    "flake8.args": [
        "--max-line-length=120",
        "--disable=D107"
    ],
    "editor.wordWrap": "on",
    "latex-workshop.docker.image.latex": "arkark/latexmk:full",
    "files.simpleDialog.enable": true,
    "C_Cpp.intelliSenseEngineFallback": "enabled",
    "asciidoc.preview.lineHeight": 1.1,
    "workbench.tree.renderIndentGuides": "always",
    "[xml]": {
        "editor.indentSize": 1,
        "editor.autoClosingBrackets": "never",
        "files.trimFinalNewlines": true,
        "editor.defaultFormatter": "DotJoshJohnson.xml"
    },
    "python.diagnostics.sourceMapsEnabled": true,
    "python.analysis.inlayHints.functionReturnTypes": true,
    "python.analysis.inlayHints.pytestParameters": true,
    "explorer.excludeGitIgnore": false,
    "editor.inlineSuggest.showToolbar": "always",
    "python.envFile": "${workspaceFolder}/.env",
    "python.autoComplete.extraPaths": [
        "/opt/ros/jazzy/lib/python3.12/site-packages",
    ],
    "python.analysis.extraPaths": [
        "/opt/ros/jazzy/lib/python3.12/site-packages",
    ],
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "explorer.confirmDragAndDrop": false,
    "betterComment.forcedLineComment": [
        "**/*.xml",
        "**/*.xacro",
        "**/*.macro",
        "**/*.html",
        "**/*.css",
        "**/*.md"
    ],
    "xml.format.spaceBeforeEmptyCloseTag": false,
    "jupyter.askForKernelRestart": false,
    "isort.check": true,
    "remote.autoForwardPortsSource": "hybrid",
    "remote.autoForwardPorts": false,
    "multiDiffEditor.experimental.enabled": true,
    "remote.forwardOnOpen": false,
    "remote.restoreForwardedPorts": false,
    "dev.containers.forwardWSLServices": false,
    "cmake.showOptionsMovedNotification": false,
    "yaml.customTags": [
        "!Sequence mapping",
        "!Service mapping",
        "!Action mapping",
        "!Skill mapping",
        "!Link scalar",
        "!Link sequence",
        "!Link mapping",
    ],
    "github.copilot.editor.enableAutoCompletions": true,
    "markdown.extension.orderedList.marker": "one",
    "terminal.integrated.commandsToSkipShell": [
        "-workbench.action.showCommands"
    ],
    "MATLAB.telemetry": false,
    "cmake.pinnedCommands": [
        "workbench.action.tasks.configureTaskRunner",
        "workbench.action.tasks.runTask"
    ],
    "cmake.showConfigureWithDebuggerNotification": false,
    "scm.showHistoryGraph": false,
    "terminal.integrated.enableImages": true,
    "chat.editing.alwaysSaveWithGeneratedChanges": true,
    // "github.copilot.nextEditSuggestions.enabled": true,
    "github.copilot.chat.editor.temporalContext.enabled": true,
    "github.copilot.chat.edits.temporalContext.enabled": true,
    "python.terminal.shellIntegration.enabled": true,
    "diffEditor.ignoreTrimWhitespace": false,
    "containers.containers.groupBy": "Compose Project Name",
    "github.copilot.chat.agent.thinkingTool": true,
    "[dockercompose]": {
        "editor.tabSize": 2,
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "C_Cpp.workspaceParsingPriority": "low",
    "chat.editing.confirmEditRequestRemoval": false,
    "git.replaceTagsWhenPull": true,
    "[csv]": {
        "editor.inlayHints.maximumLength": 0
    },
    "[tsv]": {
        "editor.inlayHints.maximumLength": 0
    },
    "urdf-visualizer.packages": {
        "kuka_iontec_support": "/home/110359@TRI.LAN/ros/jazzy/eitri_ws/src/kuka_robot_descriptions/kuka_iontec_support",
        "flexbotics_robots_kuka": "/home/110359@TRI.LAN/ros/jazzy/eitri_ws/src/flexbotics_robots_kuka/flexbotics_robots_kuka",
    },
    "cmake.enableAutomaticKitScan": false,
    "terminal.integrated.initialHint": false,
    "editor.minimap.enabled": false,
    "containers.containers.description": [
        "ImageId",
        "Status"
    ],
    "containers.containers.label": "ContainerName",
    "chat.planAgent.defaultModel": "Raptor mini (Preview) (copilot)",
    "workbench.colorTheme": "Gruvbox Dark Hard",
    "chat.viewSessions.orientation": "stacked",
    "scm.repositories.visible": 0,
    "git.repositoryScanMaxDepth": 3,
    "explorer.confirmPasteNative": false
}