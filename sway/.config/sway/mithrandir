# Machine overlay for this machine (mithrandir):
# $desks — number of desks (scripts wrap the cycle at this, default 9)
# $a..$i — outputs, mapped to workspace letters; the desk scripts use
#          only the ones currently connected. Define them contiguously.
set $desks 9
set $a DP-1
set $b HDMI-A-1

output $a {
    resolution 1920x1080@144Hz
    position 1920,0
}

output $b {
    resolution 1920x1080@60Hz
    position 0,0
}
