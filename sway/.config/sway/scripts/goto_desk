#!/bin/sh
# goto_desk <desk> — switch the whole desk: every connected output shows
# workspace <desk><letter>. Focus ends on the output you were on.
#
# Desk count is $desks in libdesk.sh (default 9); output letters are
# positional (left→right = a, b, c...). See scripts/libdesk.sh.

. "$(dirname "$0")/libdesk.sh"

desk="${1:-}"
case "$desk" in
	[1-9]) ;;
	*) die "usage: goto_desk <desk 1-9>" ;;
esac

load_desk_map
[ "$desk" -le "$desks" ] || die "desk $desk out of range (max $desks)"

# Which output is the user on? (works even from non-scheme workspaces)
cur_out=$(swaymsg -t get_workspaces -r | jq -r '.[] | select(.focused) | .output')
last=""
for l in $letters; do
	eval "o=\$out_$l"
	[ "$o" = "$cur_out" ] && last=$l
done
[ -n "$last" ] || last=$(printf '%s' "$letters" | cut -c1) # fallback: first letter

exec swaymsg --quiet "$(desk_switch_chain "$desk" "$last")"
