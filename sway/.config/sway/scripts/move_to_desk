#!/bin/sh
# move_to_desk <desk> — move the focused container to workspace
# <desk><letter> on the same output it is on, then switch the whole desk
# there (focus lands on the moved window).
#
# Desk count from $desks in the machine overlay (default 9); output letters
# from $first..$ninth. See scripts/libdesk.sh.

. "$(dirname "$0")/libdesk.sh"

desk="${1:-}"
case "$desk" in
	[0-9]) ;;
	*) die "usage: move_to_desk <desk 0-9>" ;;
esac

load_desk_map
[ "$desk" -le "$desks" ] || die "desk $desk out of range (max $desks)"

focused_letter # sets ws + letter of the focused container's output

chain="move container to workspace ${desk}${letter},$(desk_switch_chain "$desk" "$letter")"
exec swaymsg --quiet "$chain"
