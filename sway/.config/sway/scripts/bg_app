#!/bin/sh
# bg_app <command...> — launch an app so it opens on desk 0 (workspaces
# 0a..) without leaving the current desk.
#
# The app's window is routed to desk 0 by an `assign` rule in the config
# (e.g. assign [app_id="spotify"] workspace 0a); this script just makes sure
# the desk-0 workspaces exist on the right outputs first (empty workspaces
# are destroyed by sway, so desk 0 usually needs (re)creating), then spawns
# the app and restores the current desk. All in one IPC call: no flicker.

. "$(dirname "$0")/libdesk.sh"

load_desk_map
focused_letter # sets ws + letter of the current desk

case "$ws" in
	[0-9][a-z]) desk="${ws%?}" ;;
	*) desk=1 ;;
esac

chain="$(desk_switch_chain 0 "$letter"),"
chain="$chain exec $* ,"
chain="$chain$(desk_switch_chain "$desk" "$letter")"
exec swaymsg --quiet "$chain"
