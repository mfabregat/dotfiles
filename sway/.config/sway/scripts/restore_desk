#!/bin/sh
# restore_desk — re-apply the current desk to every connected output.
#
# Called from shikane profile `exec` (see ~/.config/shikane/config.toml)
# after a profile is applied at startup or on hotplug (dock/undock), so the
# workspace layout keeps matching the new output arrangement instead of
# waiting for the next $mod+N press. It reads the desk number from the
# focused workspace (e.g. "2b" -> desk 2) and reuses goto_desk.

. "$(dirname "$0")/libdesk.sh"

desk=$(swaymsg -t get_workspaces -r | jq -r '.[] | select(.focused) | .name' | cut -c1)
case "$desk" in
	[1-9]) ;;
	*) exit 0 ;; # focused workspace is not part of the desk scheme
esac

exec "$(dirname "$0")/goto_desk" "$desk"
