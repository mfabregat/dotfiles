#!/bin/sh
# desk — multi-monitor virtual desktop control for sway.
#
# Sway has no workspace groups (a "desk" = one workspace per output,
# switched atomically), so this script implements the scheme using IPC:
#   desk go <n>    — switch the whole desk: every connected output shows
#                    workspace <n><letter>; focus ends on your output.
#   desk move <n>  — move the focused container to <n><letter> on the SAME
#                    output, then switch the whole desk there.
#   desk start     — bring up desk 1 at session start (retries briefly:
#                    outputs may still be settling).
#
# Desk letters are POSITIONAL: connected outputs are sorted by their
# position in the global coordinate space (left→right, top→bottom) and
# mapped to a, b, c, ... Output geometry is declared in
# config.d/output (name blocks first, identifier blocks last), so the
# letter order is deterministic for a given arrangement (dock/undock
# stable). There is no per-machine config: the mapping is derived at
# runtime. $desks is fixed at 9 (bindings go up to $mod+9).
#
# How a switch works (smart/minimal chain):
#   * get_outputs    → sorted outputs + the focused one (1 IPC call).
#   * get_workspaces → where each <desk><letter> lives and whether it
#     is visible (1 IPC call).
#   * Build a command chain that only touches what is wrong:
#       - missing / on the wrong output: pin it, switch to it, move it
#         onto the right output (the pin also makes future creation
#         land there directly);
#       - on the right output but not yet shown: switch to it;
#       - already shown: nothing.
#   So an already-shown desk costs zero commands, a settled desk costs
#   one switch per output, and only truly misplaced workspaces get
#   yanked. The chain is idempotent — a repeat press self-heals.
#   The user's output is processed last, so focus ends there.
#
# Pointer: mouse_warping is disabled in config.d/navigation. The default
# "warp to focused output" teleports the (auto-hidden) cursor between
# monitors during a chain, and an aborted chain could leave it stranded
# on the wrong output — which reads as "can't click windows on the other
# monitor". All workspace switching goes through this script, so warping
# has no value here.

OUTPUT_LETTERS="a b c d e f g h i"
desks=9

die() { printf 'desk: %s\n' "$*" >&2; exit 1; }

# load_desk_map — sets: letters (active letters), nouts, out_<letter>,
# focused_out (output containing the focused workspace). One IPC call.
load_desk_map() {
	outputs=$(swaymsg -t get_outputs -r) || die "swaymsg failed"
	letters=""
	nouts=0
	focused_out=""
	for out in $(printf '%s' "$outputs" | jq -r '[.[] | select(.active) | {name, x: .rect.x, y: .rect.y}] | sort_by(.x, .y) | .[].name'); do
		letter=$(printf '%s' "$OUTPUT_LETTERS" | cut -d' ' -f$((nouts + 1)))
		[ -n "$letter" ] || break # more outputs than letters
		eval "out_$letter=\"$out\""
		letters="$letters $letter" # space-separated, for word splitting
		nouts=$((nouts + 1))
	done
	letters=${letters# } # strip leading space
	[ "$nouts" -ge 1 ] || die "no outputs connected"
	focused_out=$(printf '%s' "$outputs" | jq -r '.[] | select(.focused) | .name')
}

# load_ws_map <desk> — sets ws_out_<desk><letter> (output the workspace
# lives on; unset or "null" if it does not exist) and ws_vis_<desk><letter>
# (true/false) for the target desk's workspaces. One IPC call.
load_ws_map() {
	desk=$1
	workspaces=$(swaymsg -t get_workspaces -r) || die "swaymsg failed"
	eval "$(printf '%s' "$workspaces" | jq -r --arg d "$desk" \
		'.[] | select(.name | length == 2) | select(.name | startswith($d)) | "ws_out_\(.name)=\(.output | @sh) ws_vis_\(.name)=\(.visible)"')"
}

# desk_segment <desk> <letter> — print the sway commands that bring this
# output's workspace up on its own output ('' if it already is).
desk_segment() {
	desk=$1
	letter=$2
	eval "out=\$out_$letter"
	eval "wsout=\$ws_out_${desk}${letter}"
	eval "wsvis=\$ws_vis_${desk}${letter}"
	if [ "$wsout" != "$out" ]; then
		# missing or on the wrong output: pin, switch, actively move it.
		# (A missing workspace is created on the pinned output, so the
		# switch and the move are no-ops then; a misplaced one is yanked.)
		printf 'workspace %s%s output %s, workspace --no-auto-back-and-forth %s%s, move workspace to output %s' \
			"$desk" "$letter" "$out" "$desk" "$letter" "$out"
	elif [ "$wsvis" != "true" ]; then
		# on the right output but not shown yet: switch to it
		printf 'workspace --no-auto-back-and-forth %s%s' "$desk" "$letter"
	fi
}

# desk_chain <desk> <last-letter> — print the full switch chain, ending
# focus on <last> (the user's output, processed last).
desk_chain() {
	desk=$1
	last=$2
	chain=""
	for letter in $letters; do
		[ "$letter" = "$last" ] && continue
		seg=$(desk_segment "$desk" "$letter")
		[ -n "$seg" ] && chain="$chain$seg,"
	done
	seg=$(desk_segment "$desk" "$last")
	[ -n "$seg" ] && chain="$chain$seg"
	chain=${chain%,} # drop trailing comma if the last letter needs nothing
	printf '%s' "$chain"
}

# focused_letter — sets letter for focused_out (no extra IPC).
focused_letter() {
	[ -n "$focused_out" ] || die "no focused output found"
	letter=""
	for l in $letters; do
		eval "o=\$out_$l"
		[ "$o" = "$focused_out" ] && letter=$l
	done
	[ -n "$letter" ] || die "focused output \"$focused_out\" is not in the desk scheme"
}

go_desk() {
	desk="${1:-}"
	case "$desk" in
		[1-9]) ;;
		*) die "usage: desk go <desk 1-9>" ;;
	esac
	load_desk_map
	[ "$desk" -le "$desks" ] || die "desk $desk out of range (max $desks)"
	load_ws_map "$desk"

	# End focus on the output the user is on (works even from non-scheme
	# workspaces); fall back to the first letter if it is not in the scheme.
	last=""
	for l in $letters; do
		eval "o=\$out_$l"
		[ "$o" = "$focused_out" ] && last=$l
	done
	[ -n "$last" ] || last=$(printf '%s' "$letters" | cut -c1)

	chain=$(desk_chain "$desk" "$last")
	[ -n "$chain" ] || exit 0 # desk already shown — nothing to do
	exec swaymsg --quiet "$chain"
}

move_desk() {
	desk="${1:-}"
	case "$desk" in
		[1-9]) ;;
		*) die "usage: desk move <desk 1-9>" ;;
	esac
	load_desk_map
	[ "$desk" -le "$desks" ] || die "desk $desk out of range (max $desks)"
	focused_letter
	load_ws_map "$desk"

	# The container moves to this desk's workspace on the SAME output;
	# the switch chain then pins/places every output (the chain may have
	# created the target workspace, so it is not skipped just because it
	# was missing at query time — it is handled by the "missing" segment).
	chain=$(desk_chain "$desk" "$letter")
	[ -n "$chain" ] && chain=",$chain"
	exec swaymsg --quiet "move container to workspace ${desk}${letter}${chain}"
}

start() {
	# sway runs config `exec` lines only at startup (they are ignored on
	# reload), but outputs may still be settling then — retry briefly.
	# go_desk dies via `exit 1`, so run it in a subshell to keep retrying.
	i=0
	while [ "$i" -lt 10 ]; do
		if ( go_desk 1 ) 2>/dev/null; then
			exit 0
		fi
		sleep 0.5
		i=$((i + 1))
	done
	exit 1
}

case "${1:-}" in
	go)    go_desk "${2:-}" ;;
	move)  move_desk "${2:-}" ;;
	start) start ;;
	*) die "usage: desk go <desk 1-9> | desk move <desk 1-9> | desk start" ;;
esac
