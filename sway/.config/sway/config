include /etc/sway/config.d/*

# Shared defaults. This config is machine-agnostic: output geometry
# (mode, position, scale) is declared in config.d/output — name blocks
# first, identifier blocks last (identifiers follow the physical
# monitor, so the same block works on any machine). The desk script
# (scripts/desk) derives its output mapping from monitor positions at
# runtime, so no per-machine file is needed here.
include config.d/*
