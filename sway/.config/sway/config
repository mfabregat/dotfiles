include /etc/sway/config.d/*

# Shared defaults. This config is machine-agnostic: output geometry (mode,
# position, scale) is owned by shikane (~/.config/shikane/config.toml),
# which matches a profile per machine/arrangement at runtime. The desk
# scripts derive their output mapping from monitor positions (see
# scripts/libdesk.sh), so no per-machine file is needed here.
include config.d/*
