include /etc/sway/config.d/*

# Shared defaults first; machine overlays (mithrandir/tecnalia) may override
include variables
include mithrandir
# include tecnalia

include config.d/*

# Regenerate the waybar audio device menu, then start waybar (the menu XML
# is read only at startup). sway re-runs exec_always on reload without
# stopping the old instance, so kill any previous waybar first.
exec_always sh -c 'pkill -x waybar 2>/dev/null; /home/marc/.config/waybar/audio_menu.sh; exec waybar'
exec_always autotiling
exec_always sh -c 'pkill -x gammastep 2>/dev/null; exec gammastep'


# # Export Sway environment to systemd & D-Bus
# exec systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
# exec dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP=sway

# Start GNOME Keyring daemon components
exec eval $(/usr/bin/gnome-keyring-daemon --start --components=secrets,pkcs11,ssh)