### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

# Your preferred terminal emulator

set $term ghostty

# Your preferred application launcher
# Modes are enforced on the command line so the order (apps, ssh, run)
# always wins over any config-file oddities.
set $menu --no-startup-id rofi -show drun -modes "drun,ssh,run"

# set $browser brave-browser
set $browser firefox
set $editor code

# Scripts bundled with this config (kept in the config dir for portability)
set $scripts ~/.config/sway/scripts
