### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

# Your preferred terminal emulator

set $term ghostty

# Your preferred application launcher
# Toggles the quickshell launcher (drun) over IPC; Esc or click-outside closes.
set $menu quickshell ipc call launcher toggle

set $spotify flatpak run com.spotify.Client

# Notification center (quickshell IPC); bell in the bar also toggles it.
set $notifications quickshell ipc call notifications toggle

# Clipboard history (quickshell IPC); needs wl-clipboard (install.md).
set $clipboard quickshell ipc call clipboard toggle

# Screenshot area picker (quickshell IPC); replaces grimshot.
set $screenshot quickshell ipc call screenshot pick

set $browser helium
set $editor codium

# Scripts bundled with this config (kept in the config dir for portability)
set $scripts ~/.config/sway/scripts
