
exec_always sh -c 'pkill -x waybar 2>/dev/null; pkill -x quickshell 2>/dev/null; sleep 0.2; exec quickshell'
exec_always autotiling
# gammastep-indicator removed (phase 7): the quickshell NightLight service
# owns gammastep now (one daemon, controlled from the bar's night light
# popup). sway must NOT start gammastep itself — wlr-gamma-control allows
# exactly one owner; a second process hangs uselessly.

# Idle: lock after 5 min (quickshell lock), DPMS off 30 s later; any input
# or an unlock turns DPMS back on. `exec` (not exec_always) so a sway
# reload doesn't spawn a second swayidle. quickshell ipc needs no env here:
# swayidle is exec'd by sway, same environment as the $menu/$notifications binds.
exec swayidle -w \
	timeout 300 'quickshell ipc call lock lock' \
	timeout 330 'swaymsg output "*" dpms off' \
	resume 'swaymsg output "*" dpms on'

