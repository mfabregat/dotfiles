focus_follows_mouse no

# Keep the pointer put during desk switches: sway's default warp-on-
# output-change teleports the (auto-hidden) cursor between monitors as
# the desk chain hops focus across outputs; a mid-chain abort could
# leave it stranded on the wrong monitor, which reads as "can't click
# windows on the other monitor". All workspace switching goes through
# scripts/desk, so warping has no value here.
mouse_warping none

#
# Desks (dynamic scheme): workspaces are <desk><letter> (1a..9c...). A
# keybind switches the whole desk: every connected output shows
# workspace <desk><letter>. Desk letters are positional: connected
# outputs sorted by position (left→right = a, b, c...). No per-machine
# config; see scripts/desk.
#

bindsym $mod+1 exec $scripts/desk go 1
bindsym $mod+2 exec $scripts/desk go 2
bindsym $mod+3 exec $scripts/desk go 3
bindsym $mod+4 exec $scripts/desk go 4
bindsym $mod+5 exec $scripts/desk go 5
bindsym $mod+6 exec $scripts/desk go 6
bindsym $mod+7 exec $scripts/desk go 7
bindsym $mod+8 exec $scripts/desk go 8
bindsym $mod+9 exec $scripts/desk go 9

# Move container to a desk (same output), then switch the whole desk there
bindsym $mod+Shift+1 exec $scripts/desk move 1
bindsym $mod+Shift+2 exec $scripts/desk move 2
bindsym $mod+Shift+3 exec $scripts/desk move 3
bindsym $mod+Shift+4 exec $scripts/desk move 4
bindsym $mod+Shift+5 exec $scripts/desk move 5
bindsym $mod+Shift+6 exec $scripts/desk move 6
bindsym $mod+Shift+7 exec $scripts/desk move 7
bindsym $mod+Shift+8 exec $scripts/desk move 8
bindsym $mod+Shift+9 exec $scripts/desk move 9

# Start on desk 1 (sway runs exec only at startup, not on reload)
exec $scripts/desk start



# Exit sway (logs you out of your Wayland session)
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

# Moving around:
#
# Move your focus around
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
# Or use $mod+[up|down|left|right]
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move the focused window with the same, but add Shift
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
# Ditto, with arrow keys
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right


default_orientation auto