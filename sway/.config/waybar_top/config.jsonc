// -*- mode: jsonc -*-
[
    {
        // "output": [
        //     "DP-1",
        //     "HDMI-A-1"
        // ],
        "layer": "top", // Waybar at top layer
        "position": "top", // Waybar position (top|bottom|left|right)
        // Formats are wrapped in … to compress the font's
        // line height inside each pill (GTK CSS has no line-height property).
        // Tune per module: 0.75 is the floor, 0.85 is safer.
        // "width": 1280, // Waybar width
        "spacing": 4, // Gaps between modules (4px)
        // "margin-top": -6,
        // "margin-left": -6,
        // "margin-right": -6,
        // Choose the order of the modules
        "modules-left": [
            "sway/workspaces",
            "sway/mode",
            "sway/scratchpad",
            "mpris",
        ],
        "modules-center": [
            "wlr/taskbar",
            "sway/window",
        ],
        "modules-right": [
            // "load",
            "cpu",
            "memory",
            "temperature",
            "wireplumber",
            "backlight",
            "sway/language",
            "clock",
            "battery",
            "tray",
            "network",
            "custom/power"
        ],
        // Modules configuration
        "sway/workspaces": {
            "all-outputs": false, // per-output bar: only this output's workspaces
            "disable-scroll": true,
            "format": "{index}"
        },
        "sway/mode": {
            "format": "{}",
            "tooltip": false
        },
        "sway/scratchpad": {
            "format": "{count}",
            "show-empty": false,
            "tooltip": true,
            "tooltip-format": "{app}: {title}"
        },
        "sway/window": {
            "format": "{title}",
            "tooltip": false,
            // "max-length": 100,
            "all-outputs": false, // only windows on this bar's output
            "icon": true,
            "icon-size": 14
            // "expand": true
        },
        "wlr/taskbar": {
            "all-outputs": true,
            "format": "{icon}",
            "icon-size": 14,
            "icon-theme": "Numix-Circle",
            "tooltip-format": "{title}",
            "on-click": "activate",
            "on-click-middle": "close",
            "ignore-list": [
                "Alacritty"
            ],
            "app_ids-mapping": {
                "firefoxdeveloperedition": "firefox-developer-edition"
            },
            "rewrite": {
                "Firefox Web Browser": "Firefox",
                "Foot Server": "Terminal"
            }
        },
        "mpris": {
            // "player": "spotify",
            "format": "{player_icon} {dynamic}",
            "interval": 1,
            "dynamic-len": 60,
            "status-icons": {
                "playing": "▶",
                "paused": "⏸",
                "stopped": ""
            },
            "player-icons": {
                "spotify": "",
                "default": ""
            },
            "dynamic-order": [
                "title",
                "artist"
            ],
            "ignored-players": [
                "firefox"
            ],
            "tooltip": false,
            "on-click-middle": "/home/marc/.config/waybar/player_focus.sh",
        },
        "load": {
            "format": " {}"
        },
        "wireplumber": {
            "scroll-step": 5, // %, can be a float
            "format": "{volume}% {icon}",
            "format-bluetooth": "{icon} {volume}% ",
            "format-bluetooth-muted": " {icon}",
            "format-muted": " 0%",
            "format-icons": {
                "headphone": "",
                "hands-free": "", // F590 headset is FA6-only
                "headset": "",
                "phone": "",
                "portable": "",
                "car": "",
                "default": [
                    "",
                    "",
                    "",
                    ""
                ]
            },
            "tooltip": false,
            "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
            // Right-click: pick the active output device. The menu XML is
            // generated by audio_menu.sh before waybar starts (see sway
            // config); slot ids (sink1..sink8) are resolved to PipeWire node
            // ids by audio_select.sh via ~/.cache/waybar/audio_sinks.map.
            "menu": "on-click-right",
            "menu-file": "/home/marc/.cache/waybar/audio_menu.xml",
            "menu-actions": {
                "sink1": "/home/marc/.config/waybar/audio_select.sh sink1",
                "sink2": "/home/marc/.config/waybar/audio_select.sh sink2",
                "sink3": "/home/marc/.config/waybar/audio_select.sh sink3",
                "sink4": "/home/marc/.config/waybar/audio_select.sh sink4",
                "sink5": "/home/marc/.config/waybar/audio_select.sh sink5",
                "sink6": "/home/marc/.config/waybar/audio_select.sh sink6",
                "sink7": "/home/marc/.config/waybar/audio_select.sh sink7",
                "sink8": "/home/marc/.config/waybar/audio_select.sh sink8"
            }
        },
        "backlight": {
            // "device": "acpi_video1",
            "format": "{icon} {percent}%",
            "format-icons": [
                "",
                "",
                "",
                "",
                "",
                "",
                "",
                "",
                ""
            ]
        },
        "sway/language": {
            "format": "{short}",
            "on-click": "swaymsg input type:keyboard xkb_switch_layout next",
        },
        "clock": {
            "format": "{:%H:%M}",
            "tooltip-format": "<tt>{calendar}</tt>",
            "calendar": {
                "format": {
                    "today": "<span color='#ffcc66'><b>{}</b>"
                },
                "on-scroll": 1
            },
            "actions": {
                "on-scroll-up": "shift_down",
                "on-scroll-down": "shift_up",
                "on-click": "shift_reset"
            }
        },
        "battery": {
            "states": {
                // "good": 95,
                "warning": 30,
                "critical": 15
            },
            "format": "{icon} {capacity}%",
            "format-full": "{icon} {capacity}%",
            "format-charging": " {capacity}%", // bolt (F5E7 is FA6-only)
            "format-plugged": " {capacity}%",
            "format-alt": "{icon} {time}",
            // "format-good": "", // An empty format will hide the module
            // "format-full": "",
            "format-icons": [
                "",
                "",
                "",
                "",
                ""
            ]
        },
        "cpu": {
            "format": "{usage}% ",
            "states": {
                "warning": 70,
                "critical": 90
            },
            "tooltip": true
        },
        "memory": {
            "format": "{}% ",
            "states": {
                "warning": 70,
                "critical": 90
            }
        },
        "temperature": {
            // "thermal-zone": 2,
            "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
            "warning-threshold": 60,
            "critical-threshold": 80,
            // "format-critical": "{temperatureC}°C {icon}",
            "format": "{temperatureC}°C {icon}",
            "format-icons": [
                "",
                "",
                ""
            ] // FA4-safe (FA5/6-only glyphs were broken)
        },
        "tray": {
            "icon-size": 14,
            "spacing": 10
        },
        "network": {
            // "interface": "wlp2s0",
            "format": "{ifname}",
            "format-wifi": "{essid} ",
            "format-ethernet": "󰈀",
            "format-disconnected": "", //An empty format will hide the module.
            "states": {
                "wifi-weak": 30,
                "wifi-mid": 60,
                "wifi-strong": 80
            },
            "tooltip-format": "{ifname}",
            "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
            "tooltip-format-disconnected": "Disconnected",
            "max-length": 50
        },
        "custom/power": {
            "format": "⏻",
            "tooltip": false,
            "menu": "on-click",
            "menu-file": "/home/marc/.config/waybar/power_menu.xml",
            "menu-actions": {
                "lock": "swaylock",
                "logout": "swaymsg exit",
                "suspend": "systemctl suspend",
                "reboot": "systemctl reboot",
                "shutdown": "systemctl poweroff"
            }
        }
    }
]